diff --git a/hermes_cli/models.py b/hermes_cli/models.py
index 2050fb5..408235f 100644
--- a/hermes_cli/models.py
+++ b/hermes_cli/models.py
@@ -1133,6 +1133,52 @@ def get_nous_recommended_aux_model(
     return None
 
 
+def get_current_nous_free_models(
+    portal_base_url: str = "",
+    *,
+    force_refresh: bool = False,
+) -> list[str]:
+    """Return the current set of Nous models that are free for this account.
+
+    Combines the Portal's ``/api/nous/recommended-models`` free block with
+    live pricing from the Nous /v1/models endpoint, returning only model
+    IDs whose prompt AND completion price are ``$0``.  Failures are silent
+    and degrade to an empty list so callers never block on this helper.
+    """
+    try:
+        payload = fetch_nous_recommended_models(
+            portal_base_url, force_refresh=force_refresh
+        )
+    except Exception:
+        return []
+
+    free_block = payload.get("freeRecommendedModels") if isinstance(payload, dict) else None
+    if not isinstance(free_block, list) or not free_block:
+        return []
+
+    candidate_ids: list[str] = []
+    for entry in free_block:
+        name = _extract_model_name(entry)
+        if name:
+            candidate_ids.append(name)
+    if not candidate_ids:
+        return []
+
+    try:
+        pricing = get_pricing_for_provider("nous", force_refresh=force_refresh)
+    except Exception:
+        pricing = {}
+
+    if not pricing:
+        return candidate_ids
+
+    return [
+        mid
+        for mid in candidate_ids
+        if _is_model_free(mid, pricing)
+    ]
+
+
