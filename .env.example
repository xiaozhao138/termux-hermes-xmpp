# =============================================================================
# .env.example — Hermes + XMPP 环境变量模板（复制为 ~/.hermes/.env 后填写）
# 本文件可安全提交 GitHub；真实密钥一律不提交。
# 复制：cp .env.example ~/.hermes/.env
# =============================================================================

# ---------- 模型 API（必填其一） ----------
DEEPSEEK_API_KEY=
#   ↑ 填你的 DeepSeek API Key（sk-...）
# 或者用 Nous Portal OAuth（无需 Key）：hermes auth login nous

# ---------- XMPP（必填） ----------
XMPP_JID=hermes@sky.959011.xyz
#   ↑ 机器人账号 JID（默认值即本项目验证过的账号；换账号就改这里）
XMPP_PASSWORD=
#   ↑ 机器人账号密码 —— 关键秘密，install.sh 会提示填写，不要提交到 GitHub
XMPP_SERVER=sky.959011.xyz
#   ↑ XMPP 服务器域名（留空则从 JID 自动推导）
XMPP_PORT=443
#   ↑ 443 = 公网 XMPP 入口（本项目实际使用）；传统 C2S 直连用 5222
XMPP_USE_TLS=false
#   ↑ 本项目 443 入口实测为明文直连（服务器侧终止 TLS），所以为 false；
#     若走 5222 直连一般改为 true
XMPP_ALLOW_ALL_JIDS=false
#   ↑ 仅调试用，生产保持 false
XMPP_ALLOWED_JIDS=
#   ↑ 允许与机器人对话的 JID，逗号分隔。示例（你的个人 JID）：
#     XMPP_ALLOWED_JIDS=ollo@sky.959011.xyz
#   （恢复后请填你自己的 JID，否则机器人会忽略所有消息）

# ---------- 终端/浏览器（可选，保持默认即可） ----------
TERMINAL_ENV=local
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
BROWSERBASE_PROXIES=
#   ↑ 如需 Browserbase 才填（可能含代理凭据，切勿提交真实值）
BROWSERBASE_ADVANCED_STEALTH=false
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false
